# Copy to .env — NEVER commit .env or paste real keys into .env.example
#
# --- Option A: OpenAI (platform.openai.com) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
#
# --- Option B: Azure OpenAI (you have endpoint + deployment + version) ---
# If AZURE_OPENAI_ENDPOINT is set, the script uses Azure (not api.openai.com).
# Base URL only — do NOT append /openai/realtime (that breaks Chat Completions)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Exact deployment *name* from Azure AI Studio → Deployments (404 if wrong or typo).
# If you only set OPENAI_MODEL with Azure, that value must be this same deployment name.
AZURE_OPENAI_CHAT_DEPLOYMENT=your-deployment-name

# --- Qdrant (after: docker compose up -d) ---
QDRANT_A_URL=http://localhost:6333
QDRANT_B_URL=http://localhost:6334

# --- Internal service URLs (overridden by docker-compose environment) ---
# AGENT_A_URL=http://localhost:8000
# AGENT_B_URL=http://localhost:8001
# MCP_URL=http://localhost:8002
# REDIS_URL=redis://localhost:6379/0
# SESSION_TTL=86400
# LOG_DIR=/logs

# --- Embeddings (text-embedding-3-small → 1536 dims) ---
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# If Azure has NO embedding deployment, use YOUR OWN key from https://platform.openai.com/api-keys
# (chat can stay on Azure; embeddings use OpenAI platform — same vector size):
# EMBEDDINGS_OPENAI_API_KEY=sk-...
#
# Or deploy embeddings on Azure and set:
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
